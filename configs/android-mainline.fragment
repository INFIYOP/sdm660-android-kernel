# Starter fragment. Merge AFTER AOSP's kernel/configs android-base.config:
#   scripts/kconfig/merge_config.sh -m <base_defconfig> android-base.config android-mainline.fragment
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
# --- built-in parents so Android's =y netfilter/xt options are not capped to =m ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
# --- display/GPU built in so panel + msm probe without an initramfs module step ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_NOVATEK_NT36672A=y
CONFIG_HID_PLAYSTATION=y
# 7.x: iptables tables depend on the *_LEGACY switches
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_ARPTABLES=y
# DRM_MSM can only be =y if these are =y too
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_LLCC=y
# --- ported Android-only features (see 0001..0003 patches) ---
CONFIG_NETFILTER_XT_MATCH_QUOTA2=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_UID_SYS_STATS=y
# --- file-based encryption algorithms Android expects (replaces ACK-only dm-default-key path) ---
CONFIG_CRYPTO_ADIANTUM=y
CONFIG_CRYPTO_HCTR2=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CTS=y
