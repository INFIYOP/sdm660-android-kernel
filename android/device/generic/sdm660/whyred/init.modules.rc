# Load this device's kernel modules from the vendor partition. Generated from modules.all by scripts/select-modules.py.
# Display, eMMC/SD, USB and core clocks/regulators are built into the kernel; everything below is modular.
on post-fs
    exec - root -- /system/bin/modprobe -a -d /vendor/lib/modules apr ath ath10k_core ath10k_snoc bluetooth btbcm btintel btqca btrtl cfg80211 crc-ccitt ecc ecdh_generic fastrpc hci_uart led-class-flash led-class-multicolor leds-qcom-flash leds-qcom-lpg libarc4 mac80211 mc panel-synaptics-td4310 pdr_interface pinctrl-lpass-lpi pinctrl-sdm660-lpass-lpi pmi8998_fg q6adm q6afe q6afe-clocks q6afe-dai q6asm q6asm-dai q6core q6routing qcom-rng qcom-spmi-adc5 qcom-spmi-haptics qcom-spmi-rradc qcom-spmi-temp-alarm qcom-vadc-common qcom_common qcom_pdr_msg qcom_pil_info qcom_q6v5 qcom_q6v5_mss qcom_q6v5_pas qcom_smbx qcom_stats qcom_sysmon qmi_helpers rfkill rmi_core rmi_i2c rmtfs_mem rng-core snd-compress snd-q6dsp-common snd-soc-core v4l2-mem2mem venus-core venus-dec venus-enc videobuf2-common videobuf2-dma-contig videobuf2-memops videobuf2-v4l2 videodev
